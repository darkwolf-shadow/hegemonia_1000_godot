; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hegemonia 1000"
config/description="Strategico storico ambientato nell'anno 1000"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.141176, 0.141176, 0.141176, 1)
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
WorldData="*res://scripts/autoload/world_data.gd"
EconomyEngine="*res://scripts/autoload/economy_engine.gd"
AIController="*res://scripts/autoload/ai_controller.gd"
BattleSystem="*res://scripts/autoload/battle_system.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
SettlementManager="*res://scripts/autoload/settlement_manager.gd"
IconManager="*res://scripts/autoload/icon_manager.gd"
UiHelper="*res://scripts/autoload/ui_helper.gd"
AIBridge="*res://scripts/autoload/ai_bridge.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_2d=3
anti_aliasing/quality/msaa_3d=3
environment/defaults/default_clear_color=Color(0.141176, 0.141176, 0.141176, 1)
